+package baritone.api.pathing.goals;
+
+import net.minecraft.core.BlockPos;
+
+import java.util.Collection;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/** Read-only travel with the cells assigned to other workers excluded from the route. */
+public final class GoalCooperative implements Goal {
+    private final Goal destination;
+    private final Set<Long> reservations;
+
+    public GoalCooperative(Goal destination, Collection<BlockPos> reservations) {
+        this.destination = Objects.requireNonNull(destination);
+        this.reservations = reservations.stream().map(BlockPos::asLong).collect(Collectors.toUnmodifiableSet());
+    }
+
+    @Override
+    public boolean isInGoal(int x, int y, int z) {
+        return !reserved(x, y, z) && !reserved(x, y + 1, z) && destination.isInGoal(x, y, z);
+    }
+
+    @Override
+    public double heuristic(int x, int y, int z) {
+        return destination.heuristic(x, y, z);
+    }
+
+    @Override
+    public double heuristic() {
+        return destination.heuristic();
+    }
+
+    public boolean permitsMove(int x, int y, int z, int endX, int endY, int endZ) {
+        if (reservations.isEmpty()) return true;
+        // Also check cells crossed by diagonal moves, jumps, and falls. A worker already
+        // inside a reserved column may move out without occupying another reserved cell.
+        for (int mx = Math.min(x, endX); mx <= Math.max(x, endX); mx++) {
+            for (int mz = Math.min(z, endZ); mz <= Math.max(z, endZ); mz++) {
+                for (int my = Math.min(y, endY); my <= Math.max(y, endY) + 1; my++) {
+                    if (mx == x && mz == z && (endX != x || endZ != z) && (my == y || my == y + 1)) continue;
+                    if (reserved(mx, my, mz)) return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private boolean reserved(int x, int y, int z) {
+        return reservations.contains(BlockPos.asLong(x, y, z));
+    }
+
+    @Override
+    public String toString() {
+        return "Cooperative travel to " + destination;
+    }
+}
