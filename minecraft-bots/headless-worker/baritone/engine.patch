+    /// Pickup changes both the addressed slot and the carried stack.
+    fn pickup(&mut self, slot: i16, button: i8) -> Result<Value, String> {
+        let index = usize::try_from(slot).map_err(|_| "Invalid pickup slot")?;
+        let bot = self.bot()?;
+        let (seq, menu_before, slot_before, cursor_before) = {
+            let game = bot.game();
+            let slot = container_slots(&game).get(index).ok_or("Invalid pickup slot")?;
+            (game.chat_seq, menu_signature(&game), slot.clone(), game.cursor.clone())
+        };
+        let menu_id = menu_before.map(|(id, _)| id);
+        let confirmed = |game: &Game| {
+            menu_signature(game).map(|(id, _)| id) == menu_id
+                && game.cursor != cursor_before
+                && container_slots(game).get(index).is_some_and(|slot| slot != &slot_before)
+        };
+        bot.send(Cmd::Click { slot, button, mode: 0 })?;
+        let game = bot.wait_until(Duration::from_secs(2), |game| {
+            confirmed(game) || game.ended.is_some() || menu_signature(game).map(|(id, _)| id) != menu_id
+        });
+        if !confirmed(&game) || game.ended.is_some() {
+            return Err(format!("Server did not confirm the pickup at slot {slot}"));
+        }
+        Ok(after(&game, seq, menu_before))
     }

